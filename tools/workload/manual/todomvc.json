{
  "rules": [
    {
      "id": "site-docs-scaffolding",
      "match": {
        "urlGlob": "*/base.js"
      },
      "work": {
        "cacheRead": false,
        "network": false
      }
    },
    {
      "id": "presentation",
      "match": {
        "kinds": [
          "stylesheet",
          "favicon"
        ]
      },
      "work": {
        "cacheRead": false,
        "network": false
      }
    }
  ],
  "presets": [
    "noVisualAssets",
    "noSpeculativeLoads"
  ]
}

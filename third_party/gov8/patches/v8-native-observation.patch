+namespace {
+// Admission is scoped to compilation, never inferred from author-controlled
+// resource names or held while executing JavaScript.
+thread_local bool platform_bootstrap_compilation = false;
+struct PlatformBootstrapCompilationScope {
+  bool previous = platform_bootstrap_compilation;
+  PlatformBootstrapCompilationScope() { platform_bootstrap_compilation = true; }
+  ~PlatformBootstrapCompilationScope() {
+    platform_bootstrap_compilation = previous;
+  }
+};
+
+template <typename T>
+v8::Local<T> PlatformLocalFromSlot(const T* slot) {
+  static_assert(sizeof(v8::Local<T>) == sizeof(slot));
+  v8::Local<T> local;
+  memcpy(&local, &slot, sizeof(local));
+  return local;
+}
+}  // namespace
+
+// Ordinary Error retains its original constructor message. Platform exception
+// objects deliberately omit that state, allowing V8's lazy formatter to observe
+// their current interface name/message exactly as a native DOMException does.
+extern "C" V8_EXPORT bool v8__Mimic__ClearExceptionOriginalMessage(
+    v8::Isolate* isolate, const v8::Object* object) {
+  auto local = PlatformLocalFromSlot(object);
+  if (!local->IsNativeError()) return false;
+  auto i_isolate = reinterpret_cast<i::Isolate*>(isolate);
+  return i::JSReceiver::DeletePropertyOrElement(
+      i_isolate, Utils::OpenDirectHandle(object),
+      i_isolate->factory()->error_message_symbol(), i::LanguageMode::kSloppy)
+      .FromMaybe(false);
+}
+
+extern "C" V8_EXPORT bool v8__Mimic__IsPlatformBootstrapCompilation() {
+  return platform_bootstrap_compilation;
+}
+
+extern "C" V8_EXPORT const v8::Function* v8__Mimic__CompilePlatformFunction(
+    const v8::Context* context, v8::ScriptCompiler::Source* source,
+    size_t arguments_count, const v8::String** arguments,
+    size_t context_extension_count, const v8::Object** context_extensions,
+    v8::ScriptCompiler::CompileOptions options,
+    v8::ScriptCompiler::NoCacheReason no_cache_reason) {
+  PlatformBootstrapCompilationScope admission;
+  std::vector<v8::Local<v8::String>> argument_handles;
+  argument_handles.reserve(arguments_count);
+  for (size_t index = 0; index < arguments_count; ++index) {
+    argument_handles.push_back(PlatformLocalFromSlot(arguments[index]));
+  }
+  std::vector<v8::Local<v8::Object>> extension_handles;
+  extension_handles.reserve(context_extension_count);
+  for (size_t index = 0; index < context_extension_count; ++index) {
+    extension_handles.push_back(PlatformLocalFromSlot(context_extensions[index]));
+  }
+  v8::Local<v8::Function> result;
+  if (!v8::ScriptCompiler::CompileFunction(
+           PlatformLocalFromSlot(context), source, arguments_count,
+           argument_handles.data(), context_extension_count,
+           extension_handles.data(), options, no_cache_reason).ToLocal(&result)) {
+    return nullptr;
+  }
+  return *result;
+}
+
+extern "C" V8_EXPORT const v8::Script* v8__Mimic__CompilePlatformScript(
+    const v8::Context* context, const v8::String* source) {
+  PlatformBootstrapCompilationScope admission;
+  v8::Local<v8::Script> result;
+  if (!v8::Script::Compile(PlatformLocalFromSlot(context),
+                           PlatformLocalFromSlot(source)).ToLocal(&result)) {
+    return nullptr;
+  }
+  return *result;
+}
